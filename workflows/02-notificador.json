      "id": "88c75374-f4c6-9f9c-faa5-3a052c6506c9",
      "name": "Recibir avisos",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Detecta cambios de estado con Static Data (solo persiste en ejecuciones NO manuales).\nconst sd = $getWorkflowStaticData('global');\nif (!sd.estados) sd.estados = {};\nconst out = [];\nfor (const it of $input.all()) {\n  const { tipo, clave, estado, detalle } = it.json;\n  let anterior = null, notificar = false, motivo = '', aviso = '';\n  if (tipo === 'incidencia') {\n    notificar = true; motivo = 'Incidencia: siempre se notifica'; aviso = 'CRITICO'; anterior = '-';\n  } else {\n    anterior = sd.estados[clave] ?? null;\n    if (anterior === null) {\n      notificar = estado !== 'OK';\n      motivo = notificar ? 'Primera vez y no está OK' : 'Primera vez y está OK';\n    } else if (anterior !== estado) {\n      notificar = true; motivo = `Cambio ${anterior} -> ${estado}`;\n    } else {\n      motivo = 'Sin cambios';\n    }\n    sd.estados[clave] = estado;\n    if (estado === 'CAÍDO') aviso = 'CRITICO';\n    else if (estado === 'DEGRADADO') aviso = 'AVISO';\n    else if (estado === 'OK') aviso = 'RECUPERADO';\n    // Solo es recuperación si veníamos de un estado no OK\n    if (notificar && estado === 'OK' && (anterior === null || anterior === 'OK')) notificar = false;\n  }\n  out.push({ json: { tipo, clave, estado, detalle, anterior: anterior ?? '(primera vez)', notificar, motivo, aviso } });\n}\nreturn out;"
      },
