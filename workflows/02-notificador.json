    {
      "parameters": {
        "jsCode": "// Construye asunto y cuerpo HTML con tabla.\nreturn $input.all().map(it => {\n  const j = it.json;\n  const fecha = new Date().toISOString();\n  const etiqueta = j.tipo === 'incidencia' ? 'Incidencia' : 'Servicio';\n  const html = `<h2>${j.prefijo} ${j.clave}</h2>\n<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">\n<tr><th align=\"left\">${etiqueta}</th><td>${j.clave}</td></tr>\n<tr><th align=\"left\">Estado anterior</th><td>${j.anterior}</td></tr>\n<tr><th align=\"left\">Estado nuevo</th><td>${j.estado}</td></tr>\n<tr><th align=\"left\">Detalle</th><td>${j.detalle ?? ''}</td></tr>\n<tr><th align=\"left\">Fecha</th><td>${fecha}</td></tr></table>`;\n  return { json: { ...j, asunto: `${j.prefijo} ${j.clave} – ${j.estado}`, html } };\n});"
      },
