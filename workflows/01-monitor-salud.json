    {
      "parameters": {
        "jsCode": "// Cuenta los avisos enviados y los anota en el log de la ejecución.\nconst res = $input.all().map(i => i.json);\nconst enviados = res.filter(r => r.notificado === true).length;\nconsole.log(`Monitor de salud: ${enviados} avisos enviados de ${res.length} servicios`);\nreturn [{ json: { servicios: res.length, avisos_enviados: enviados } }];"
      },
