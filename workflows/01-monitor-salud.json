      "parameters": {
        "jsCode": "// ÚNICO punto de configuración: servicios, umbral y timeout.\nconst umbral_ms = 1500, timeout_ms = 5000;\nconst servicios = [\n  ['api-posts', 'https://jsonplaceholder.typicode.com/posts/1'],\n  ['api-chuck', 'https://api.chucknorris.io/jokes/random'],\n  ['api-lenta', 'https://httpbin.org/delay/2'],\n  ['api-503', 'https://httpbin.org/status/503'],\n  ['api-404', 'https://jsonplaceholder.typicode.com/posts/9999'],\n  ['dominio-roto', 'https://servicio-inexistente.ucjc-practica.invalid'],\n];\nreturn servicios.map(([servicio, url]) => ({ json: { servicio, url, umbral_ms, timeout_ms } }));"
      },
