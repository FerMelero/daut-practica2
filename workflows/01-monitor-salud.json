    {
      "parameters": {
        "jsCode": "// Convierte los resultados del bucle al contrato del notificador.\nreturn $input.all().map(it => {\n  const r = it.json;\n  const detalle = r.error ? `Error: ${r.error}` : `HTTP ${r.http_status} en ${r.latencia_ms} ms`;\n  return { json: { tipo: 'estado', clave: r.servicio, estado: r.estado, detalle } };\n});"
      },
